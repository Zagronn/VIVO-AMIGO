# Copy this file to .env before running the app.

# PostgreSQL connection string. Easiest local options:
#  - Docker: `docker compose up -d` (see docker-compose.yml) then use the URL below as-is.
#  - Or a free hosted instance (Neon, Supabase, Railway) — paste their connection string here.
DATABASE_URL="postgresql://vivo:vivo@localhost:5432/vivoamigo"

# Any long random string — used to sign session cookies.
SESSION_SECRET="change-this-to-a-long-random-string"

# Optional. Powers the VIVO SUPPORT AI chat assistant at /support. Without
# this, the chat widget renders fine but shows a friendly "not configured
# yet" message instead of replying. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
